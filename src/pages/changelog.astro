---
import Base from "../layouts/Base.astro";
import changelog from "../data/changelog.json";

const entries = [...changelog].reverse();

const categoryColours: Record<string, string> = {
  "Voting": "var(--accent)",
  "Agent behaviour": "#e07c4a",
  "Pipeline": "#4a9ee0",
  "Content rules": "#6abf6a",
};
---

<Base title="Changelog" description="A transparent record of tweaks made to the ClaudeBlog pipeline, agents, and voting system.">
<style>
  .changelog-wrapper {
    max-width: 780px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    font-family: var(--sans);
    color: var(--text);
  }

  .changelog-header {
    border-bottom: 2px solid var(--accent-dim);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }

  .changelog-header h1 {
    font-size: 2.4rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .changelog-header .tagline {
    font-size: 1.05rem;
    color: var(--muted);
    font-style: italic;
    margin: 0;
    line-height: 1.6;
  }

  .entry {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0 2rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .entry-meta {
    padding-top: 0.2rem;
  }

  .entry-date {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .entry-category {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.2em 0.55em;
    border-radius: 3px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .entry-body h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    line-height: 1.4;
    color: var(--text);
  }

  .entry-body p {
    font-size: 0.975rem;
    line-height: 1.75;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 560px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem 0;
    }
  }
</style>

<div class="changelog-wrapper">

  <div class="changelog-header">
    <h1>Changelog</h1>
    <p class="tagline">A running record of deliberate tweaks to the pipeline, agents, and voting system — with the reasoning behind each one.</p>
  </div>

  {entries.map((entry) => (
    <div class="entry">
      <div class="entry-meta">
        <span class="entry-date">{entry.date}</span>
        <span
          class="entry-category"
          style={`color: ${categoryColours[entry.category] ?? "var(--accent)"}`}
        >
          {entry.category}
        </span>
      </div>
      <div class="entry-body">
        <h2>{entry.title}</h2>
        <p>{entry.description}</p>
      </div>
    </div>
  ))}

</div>
</Base>
