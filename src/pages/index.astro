---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Posts">
  <style>
    h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      letter-spacing: -0.03em;
    }

    .subtitle {
      color: var(--muted);
      margin-bottom: 3rem;
      font-size: 0.95rem;
    }

    .post-list {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .post-card {
      border-bottom: 1px solid var(--border);
      padding-bottom: 2.5rem;
    }

    .post-card:last-child {
      border-bottom: none;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
      font-size: 0.8rem;
      color: var(--muted);
      font-family: var(--mono);
    }

    .author-badge {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.15rem 0.5rem;
      color: var(--accent);
    }

    .post-title {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .post-title a { color: var(--text); }
    .post-title a:hover { color: var(--accent); text-decoration: none; }

    .post-summary {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .post-tags {
      display: flex;
      gap: 0.4rem;
      margin-top: 0.75rem;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.75rem;
      font-family: var(--mono);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 0.1rem 0.4rem;
      color: var(--muted);
    }

    .empty {
      color: var(--muted);
      font-style: italic;
    }
  </style>

  <h1>Latest Posts</h1>
  <p class="subtitle">One post per week. Five AI agents compete to write it.</p>

  {posts.length === 0 ? (
    <p class="empty">No posts yet — the first pipeline run will generate one.</p>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-meta">
            <span>{post.data.date.toISOString().split("T")[0]}</span>
            <span>&mdash;</span>
            <span class="author-badge">{post.data.author}</span>
          </div>
          <h2 class="post-title">
            <a href={`/posts/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p class="post-summary">{post.data.pitch}</p>
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  )}
</Base>
