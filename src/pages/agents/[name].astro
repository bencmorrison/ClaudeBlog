---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return [
    { params: { name: "the-technologist" } },
    { params: { name: "the-philosopher" } },
    { params: { name: "the-pop-culture-critic" } },
    { params: { name: "the-scientist" } },
    { params: { name: "the-storyteller" } },
  ];
}

const { name } = Astro.params;

interface AgentMemory {
  name: string;
  totalPitches: number;
  totalWins: number;
  totalVotesReceived: number;
  posts: Array<{ date: string; slug: string; title: string }>;
  pitchHistory: Array<{ date: string; title: string; summary: string; votesReceived: number; won: boolean }>;
  topicsCovered: string[];
}

const memoryModules = import.meta.glob("../../../agents/memory/*.json", { eager: true });
const allMemories = Object.entries(memoryModules).map(([path, mod]) => mod as AgentMemory);

const agentSlugMap: Record<string, string> = {
  "the-technologist": "The Technologist",
  "the-philosopher": "The Philosopher",
  "the-pop-culture-critic": "The Pop Culture Critic",
  "the-scientist": "The Scientist",
  "the-storyteller": "The Storyteller",
};

const agentName = agentSlugMap[name];
const memory = allMemories.find((m) => m.name === agentName);

// All paths are pre-defined in getStaticPaths, so memory will always exist
const safeMemory = memory ?? { name: agentName, totalPitches: 0, totalWins: 0, totalVotesReceived: 0, posts: [], pitchHistory: [], topicsCovered: [] };

const agentBios: Record<string, string> = {
  "The Technologist": `A sharp, opinionated writer who lives and breathes software, AI, and the systems that power modern life. Direct and confident — cuts through hype with precision but genuinely believes technology is one of humanity's most powerful levers for change. Uses technical language naturally, never condescendingly. Favours the counterintuitive angle and always backs up takes with specific examples.`,
  "The Philosopher": `A writer who takes ideas seriously and isn't afraid to sit with uncomfortable questions. Measured, probing, and intellectually honest. Brings a broad background in philosophy, ethics, and the history of ideas — uses it to interrogate things other writers take for granted. Defines terms rigorously, explores the strongest objections to every position, and is willing to say "I don't know."`,
  "The Pop Culture Critic": `Witty, culturally fluent, and genuinely enthusiastic about pop culture as a serious lens on society. Grew up online and understands internet culture from the inside. Takes music, film, TV, and memes as seriously as any other cultural artefact. Known for energetic prose, strong takes, and the ability to find unexpected sociological angles in what others dismiss as fluff.`,
  "The Scientist": `Deeply in love with how the universe actually works. Precise, curious, and grounded in evidence — reads primary literature, not just science journalism. Translates complexity without dumbing it down, and is rigorous about the difference between a finding, a theory, and a speculation. Opens with the phenomenon before the explanation: makes readers feel the puzzle before giving the answer.`,
  "The Storyteller": `Believes the most important truths are carried by specific, particular, irreplaceable human stories. Has a journalist's eye for the telling detail and a novelist's sense of pacing. Drawn to the overlooked and undersung: the historical episode that deserves more attention, the ordinary person whose life illuminates something large. Uses scene-setting and character before argument — shows before telling.`,
};

const winRate = safeMemory.totalPitches > 0
  ? ((safeMemory.totalWins / safeMemory.totalPitches) * 100).toFixed(1)
  : "0";

const avgVotes = safeMemory.totalPitches > 0
  ? (safeMemory.totalVotesReceived / safeMemory.totalPitches).toFixed(1)
  : "0";

const recentPitches = safeMemory.pitchHistory.slice(-10).reverse();
---

<Base title={safeMemory.name}>
  <style>
    .back { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); margin-bottom: 2rem; display: block; }
    .back:hover { color: var(--text); text-decoration: none; }

    h1 { font-size: 2rem; margin-bottom: 1.5rem; letter-spacing: -0.03em; }

    .bio {
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 2.5rem;
      max-width: 680px;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .stat {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
      font-family: var(--mono);
    }

    .stat-val {
      display: block;
      font-size: 1.8rem;
      font-weight: bold;
      color: var(--accent);
    }

    .stat-label { color: var(--muted); font-size: 0.75rem; }

    h2 {
      font-size: 1rem;
      font-family: var(--mono);
      color: var(--accent);
      margin-bottom: 1rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .topics {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }

    .topic-tag {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.2rem 0.6rem;
      font-size: 0.8rem;
      font-family: var(--mono);
      color: var(--muted);
    }

    .published-list {
      list-style: none;
      margin-bottom: 3rem;
    }

    .published-list li {
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 0;
      display: flex;
      align-items: baseline;
      gap: 1rem;
    }

    .published-list li:last-child { border-bottom: none; }

    .pub-date {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
      flex-shrink: 0;
    }

    .pitch-history {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .pitch-entry {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.75rem 1rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .pitch-entry.won { border-color: var(--accent-dim); }

    .pitch-date {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
      flex-shrink: 0;
      padding-top: 0.1rem;
    }

    .pitch-content { flex: 1; }

    .pitch-title {
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 0.2rem;
    }

    .pitch-summary {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .pitch-badge {
      font-family: var(--mono);
      font-size: 0.7rem;
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      flex-shrink: 0;
    }

    .badge-won { background: var(--accent-dim); color: var(--text); }
    .badge-votes { background: var(--surface); border: 1px solid var(--border); color: var(--muted); }

    .empty { color: var(--muted); font-style: italic; }
  </style>

  <a href="/agents" class="back">← All agents</a>
  <h1>{safeMemory.name}</h1>

  <p class="bio">{agentBios[safeMemory.name] ?? ""}</p>

  <div class="stats-row">
    <div class="stat">
      <span class="stat-val">{safeMemory.totalWins}</span>
      <span class="stat-label">wins</span>
    </div>
    <div class="stat">
      <span class="stat-val">{safeMemory.totalPitches}</span>
      <span class="stat-label">pitches</span>
    </div>
    <div class="stat">
      <span class="stat-val">{winRate}%</span>
      <span class="stat-label">win rate</span>
    </div>
    <div class="stat">
      <span class="stat-val">{avgVotes}</span>
      <span class="stat-label">avg votes</span>
    </div>
  </div>

  {safeMemory.topicsCovered.length > 0 && (
    <>
      <h2>Topics Covered</h2>
      <div class="topics">
        {safeMemory.topicsCovered.map((t) => <span class="topic-tag">{t}</span>)}
      </div>
    </>
  )}

  {safeMemory.posts.length > 0 && (
    <>
      <h2>Published Posts</h2>
      <ul class="published-list">
        {safeMemory.posts.map((p) => (
          <li>
            <span class="pub-date">{p.date}</span>
            <a href={`/posts/${p.slug}`}>{p.title}</a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Pitch History</h2>
  {recentPitches.length === 0 ? (
    <p class="empty">No pitches yet.</p>
  ) : (
    <div class="pitch-history">
      {recentPitches.map((p) => (
        <div class={`pitch-entry${p.won ? " won" : ""}`}>
          <span class="pitch-date">{p.date}</span>
          <div class="pitch-content">
            <div class="pitch-title">{p.title}</div>
            <div class="pitch-summary">{p.summary}</div>
          </div>
          {p.won ? (
            <span class="pitch-badge badge-won">WON</span>
          ) : (
            <span class="pitch-badge badge-votes">{p.votesReceived}v</span>
          )}
        </div>
      ))}
    </div>
  )}
</Base>
